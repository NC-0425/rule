[Plugin]
name = 综合 IP、测速与防 DNS 泄露分红插件
desc = 整合了 IP 查询、测速、Cloudflare 域名、全套防 DNS 泄露（Port 53 及泄露测试域名）的高级 Loon 插件。
author = User
icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Global.png

[Argument]
# 支持在 Loon 导入时自由下拉或修改绑定你配置的代理策略组名称
target_policy = select,"PROXY","DIRECT","?? 全球直连","???? 香港节点","???? 美国节点",tag=选择代理策略,desc=请选择此插件包含的所有分流规则要走的代理策略

[Rule]
# ==========================================
# 1. 完整防 DNS 泄露与公共 DNS 拦截规则
# ==========================================
PORT,53,$target_policy

IP-CIDR,1.1.1.1/32,$target_policy,no-resolve
IP-CIDR,1.0.0.1/32,$target_policy,no-resolve
IP-CIDR,8.8.8.8/32,$target_policy,no-resolve
IP-CIDR,8.8.4.4/32,$target_policy,no-resolve
IP-CIDR,9.9.9.9/32,$target_policy,no-resolve
IP-CIDR,149.112.112.112/32,$target_policy,no-resolve
IP-CIDR,208.67.222.222/32,$target_policy,no-resolve
IP-CIDR,208.67.220.220/32,$target_policy,no-resolve

# 补充原插件的防 DNS 泄露专属域名
DOMAIN-SUFFIX,dnsleaktest.com,$target_policy
DOMAIN-SUFFIX,dnsleak.com,$target_policy
DOMAIN-SUFFIX,expressvpn.com,$target_policy
DOMAIN-SUFFIX,ipleak.net,$target_policy
DOMAIN-SUFFIX,perfect-privacy.com,$target_policy

# ==========================================
# 2. IP 查询、测速与工具域名规则
# ==========================================
IP-CIDR,142.251.215.0/24,$target_policy,no-resolve
IP-CIDR,74.125.250.129/24,$target_policy,no-resolve

DOMAIN-SUFFIX,yalala.com,$target_policy
DOMAIN-SUFFIX,whois.pconline.com.cn,$target_policy
DOMAIN-SUFFIX,ipip.net,$target_policy
DOMAIN-SUFFIX,b0.upaiyun.com,$target_policy
DOMAIN-SUFFIX,asn247.net,$target_policy
DOMAIN-SUFFIX,astrill.org,$target_policy
DOMAIN-SUFFIX,ipinfo.io,$target_policy

DOMAIN-SUFFIX,vultr.com,$target_policy
DOMAIN-SUFFIX,test-ipv6.com,$target_policy
DOMAIN-SUFFIX,ipw.cn,$target_policy

DOMAIN-SUFFIX,ipcheck.im,$target_policy
DOMAIN,challenges.cloudflare.com,$target_policy
DOMAIN,speed.cloudflare.com,$target_policy
DOMAIN-SUFFIX,fast.com,$target_policy
# DOMAIN,ichnaea-web.netflix.com,$target_policy
# DOMAIN-SUFFIX,1.oca.nflxvideo.net,$target_policy
DOMAIN-SUFFIX,speedcheck.org,$target_policy
DOMAIN-SUFFIX,speedtest.net,$target_policy
DOMAIN-SUFFIX,speedtest.cn,$target_policy
DOMAIN-SUFFIX,ustc.edu.cn,$target_policy
DOMAIN-SUFFIX,dnscheck.tools,$target_policy
DOMAIN-SUFFIX,whoer.net,$target_policy
DOMAIN-SUFFIX,browserleaks.com,$target_policy
DOMAIN-SUFFIX,browserleaks.org,$target_policy
DOMAIN-SUFFIX,browserleaks.net,$target_policy
DOMAIN-SUFFIX,dnsleaktest.org,$target_policy
DOMAIN-SUFFIX,1-b.net,$target_policy
DOMAIN-SUFFIX,workers.dev,$target_policy
DOMAIN-SUFFIX,jsonp-ip.com,$target_policy
DOMAIN-SUFFIX,sspanel.net,$target_policy

DOMAIN-SUFFIX,browserscan.net,$target_policy
DOMAIN-SUFFIX,surfshark.com,$target_policy
DOMAIN-SUFFIX,surfsharkdns.com,$target_policy
DOMAIN-SUFFIX,ip-api.com,$target_policy

DOMAIN-SUFFIX,ip-score.com,$target_policy
DOMAIN-SUFFIX,888005.xyz,$target_policy
DOMAIN-SUFFIX,incolumitas.com,$target_policy

DOMAIN-SUFFIX,null-addr.com,$target_policy
DOMAIN-SUFFIX,null-addr.net,$target_policy
DOMAIN-SUFFIX,null-addr.org,$target_policy
DOMAIN-SUFFIX,null-addr.biz,$target_policy
DOMAIN-SUFFIX,null-addr.info,$target_policy
DOMAIN-SUFFIX,addr.tools,$target_policy

DOMAIN-SUFFIX,ifconfig.me,$target_policy
DOMAIN-SUFFIX,ip125.com,$target_policy
DOMAIN-SUFFIX,skk.moe,$target_policy
DOMAIN-SUFFIX,ip111.cn,$target_policy
DOMAIN-SUFFIX,ping0.cc,$target_policy
DOMAIN-SUFFIX,ip.sb,$target_policy
DOMAIN-SUFFIX,ipify.org,$target_policy
DOMAIN-SUFFIX,whoer.com,$target_policy
DOMAIN-SUFFIX,whatismyip.com.tw,$target_policy
DOMAIN-SUFFIX,whatismyip.com,$target_policy
DOMAIN-SUFFIX,whoisip.me,$target_policy
DOMAIN-SUFFIX,ipaddress.me,$target_policy
DOMAIN-SUFFIX,ip2proxy.com,$target_policy
