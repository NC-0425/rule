# ==============================================================================
# Autodesk (AutoCAD 等) 反盗版检测与联网拦截规则
# ==============================================================================

# 1. 核心反盗版/证书无效弹窗检测
DOMAIN-SUFFIX,api.genuine.autodesk.com
DOMAIN-SUFFIX,genuine.autodesk.com
DOMAIN-SUFFIX,native.auth.autodesk.com
DOMAIN-SUFFIX,access.clic.autodesk.com
DOMAIN-SUFFIX,clm.clic.autodesk.com
DOMAIN-SUFFIX,registeronce.autodesk.com
DOMAIN-SUFFIX,cur.autodesk.com
DOMAIN-SUFFIX,genuine-software.autodesk.com
DOMAIN-SUFFIX,genuine-software2.autodesk.com
DOMAIN-SUFFIX,genuine-software3.autodesk.com

# 2. 许可证与身份验证核心域名
DOMAIN-SUFFIX,licensing.autodesk.com
DOMAIN-SUFFIX,licenses.autodesk.com
DOMAIN-SUFFIX,identity.api.autodesk.com
DOMAIN-SUFFIX,api.autodesk.com
DOMAIN-SUFFIX,accounts.autodesk.com
DOMAIN-SUFFIX,auth.autodesk.com

# 3. 遥测、数据收集与统计
DOMAIN-SUFFIX,clm.autodesk.com
DOMAIN-SUFFIX,telemetry.autodesk.com
DOMAIN-SUFFIX,ipm.autodesk.com

# ==============================================================================
# 红果短剧广告拦截
# ==============================================================================
# ----------------------------------------------------
# name: 红果短剧综合去广告综合规则集 · 2026 最终整合版
# desc: 完美合并全套核心域、字节兜底关键词、第三方 SDK 以及高级路径正则
# ----------------------------------------------------
payload:
  # ① 红果核心与字节商业化专属域名 (直接封禁)
  - DOMAIN-SUFFIX,hongguoapp.com
  - DOMAIN-SUFFIX,hongguosdk.com
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao.com
  - DOMAIN-SUFFIX,pglstatp-toutiao.com
  - DOMAIN-SUFFIX,ad.pangle.cn
  - DOMAIN-SUFFIX,ad.pangolin.cn
  - DOMAIN-SUFFIX,pangle.io
  - DOMAIN-SUFFIX,zijieapi.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://awemeughun.com
  - DOMAIN,dig.bdurl.net
  - DOMAIN,://byteimg.com
  - DOMAIN,://byteimg.com
  - DOMAIN,://ctobsnssdk.com
  - DOMAIN,://bytedance.com
  - DOMAIN,://snssdk.com
  - DOMAIN,://snssdk.com

  # ② 红果接入的第三方兜底广告聯盟 (直接封禁)
  - DOMAIN-SUFFIX,://qq.com
  - DOMAIN-SUFFIX,miaozhen.com
  - DOMAIN-SUFFIX,doubleclick.net
  
  # ③ 核心广告特征关键词拦截 (域名包含即封禁)
  - DOMAIN-KEYWORD,ad-union-sdk
  - DOMAIN-KEYWORD,be-pack
  - DOMAIN-KEYWORD,hongguo.ad
  - DOMAIN-KEYWORD,tnc.snssdk
  - DOMAIN-KEYWORD,volcengine-ad

  # ④ 高风险共享域名 (采用精准路径过滤，保护正常剧集不误杀)
  - URL-REGEX,(ad-app-package|ad-pattern|ad-sign|track_log|get_ads|union/sdk)
  - URL-REGEX,(\/obj\/ad\/|\/obj\/img\/ad\/)
  - URL-REGEX,(\?from=ad)
  - URL-REGEX,(^https:\/\/(i|i-lq)\.snssdk\.com\/api\/ad\/)
  - URL-REGEX,(^https:\/\/(i|i-lq)\.snssdk\.com\/.*\/(ad|ads|advert|advertisement)\/)
