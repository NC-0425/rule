# ------------------------------------------
# 5. TMDB 媒体刮削及图片 CDN (精准与后缀匹配)
# ------------------------------------------
# TMDB 核心 API 与网页
DOMAIN-KEYWORD,tmdb
DOMAIN-KEYWORD,themoviedb
DOMAIN-SUFFIX,tmdb.org
DOMAIN-SUFFIX,themoviedb.org
# TMDB 最新 Bunny.net 图片 CDN (2025/2026 必加)
DOMAIN,tmdb-image-prod.b-cdn.net
DOMAIN,tmdb-web-image-prod.b-cdn.net
# TMDB 传统图片服务器
DOMAIN-SUFFIX,image.tmdb.org

# ------------------------------------------
# 6. IMDb 影视数据库
# ------------------------------------------
# IMDb 票房数据网站 Box Office Mojo
DOMAIN-SUFFIX,boxofficemojo.com
# IMDb 官方网站及相关服务
DOMAIN-SUFFIX,imdb.com
DOMAIN-SUFFIX,imdb.to
DOMAIN-SUFFIX,media-imdb.com
DOMAIN-SUFFIX,media-amazon.com
# 第三方 IMDb API 服务 (如 IMDxAPI)
DOMAIN-SUFFIX,tiffara.com
