# ==============================================================================
# PT 站点 / Tracker / 影视配套工具 / IP 检测 —— 直连规则集
# ==============================================================================
# 【必须遵守的顺序】
#   本规则集必须整块排在「代理规则集」之前。
#   否则 tracker 会先被代理规则命中，以代理 IP 上报 → 站点判定 IP 不一致 / 多 IP 下载。
#
# 【用法一】作为 rule-providers 引用（推荐）
#   rule-providers:
#     pt-direct:
#       type: file
#       behavior: domain
#       format: yaml
#       path: ./rules/pt-direct.yaml
#
# 【用法二】直接写入主配置 rules: 段
#   删除 payload: 一行，并为每条补第三列策略（如 DOMAIN-KEYWORD,tracker,DIRECT）
# ==============================================================================

payload:
  # ============================================================================
  # 一、 全局关键字匹配（Tracker 关键字）
  # ============================================================================
  # 注意：私有站的 announce 多为「站点域名/announce.php」，
  #       域名本身不含 tracker/announce，这三条关键字抓不到，
  #       靠后面各站的 DOMAIN-SUFFIX 兜底。最终保险见文末「进程规则」。
  - DOMAIN-KEYWORD,tracker
  - DOMAIN-KEYWORD,announce
  - DOMAIN-KEYWORD,torrent
  # 予初Emby
  - DOMAIN-KEYWORD,yusen

  # ============================================================================
  # 二、 顶级 / 老牌 / 大中型综合 PT 站点
  # ============================================================================
  # M-Team (馒头)
  - DOMAIN-SUFFIX,m-team.io
  - DOMAIN-SUFFIX,m-team.cc
  - DOMAIN-KEYWORD,m-team

  # HDSky (天空)
  - DOMAIN-SUFFIX,hdsky.me
  - DOMAIN-SUFFIX,hdsky.my
  - DOMAIN-KEYWORD,hdsky

  # CHD (彩虹岛)
  - DOMAIN-SUFFIX,chdbits.xyz
  - DOMAIN-SUFFIX,ptchdbits.co
  - DOMAIN,tracker.rainbowisland.co
  - DOMAIN-KEYWORD,chdbits
  - DOMAIN-KEYWORD,ptchdbits

  # Audiences (观众)
  - DOMAIN-SUFFIX,audiences.me
  - DOMAIN-SUFFIX,cinefiles.info
  - DOMAIN-KEYWORD,audiences

  # HHAnClub (憨憨)
  - DOMAIN-SUFFIX,hhanclub.net
  - DOMAIN,tracker.hhanclub.net
  - DOMAIN-KEYWORD,hhanclub

  # Ourbits (我堡)
  - DOMAIN-SUFFIX,ourbits.club
  - DOMAIN-KEYWORD,ourbits

  # TTG (听听歌)
  - DOMAIN-SUFFIX,totheglory.im
  - DOMAIN-KEYWORD,totheglory

  # PterClub (猫站)
  - DOMAIN-SUFFIX,pterclub.net
  - DOMAIN-KEYWORD,pterclub

  # SSD (春天)
  - DOMAIN-SUFFIX,springsunday.net
  - DOMAIN-KEYWORD,springsunday

  # HDHome (家园)
  - DOMAIN-SUFFIX,hdhome.org
  - DOMAIN-KEYWORD,hdhome

  # KeepFRDS (朋友)
  - DOMAIN-SUFFIX,keepfrds.com
  - DOMAIN-KEYWORD,keepfrds

  # OpenCD (皇后 / 华语无损音乐)
  - DOMAIN-SUFFIX,opencd.org
  - DOMAIN-KEYWORD,opencd

  # ============================================================================
  # 三、 垂直及主流中型站点
  # ============================================================================
  # UBits (U堡)
  - DOMAIN-SUFFIX,ubits.club
  - DOMAIN-KEYWORD,ubits

  # SunnyPT (阳光)
  - DOMAIN-SUFFIX,sunnypt.top
  - DOMAIN-KEYWORD,sunnypt

  # PTTime (PT时间)
  - DOMAIN-SUFFIX,pttime.org
  - DOMAIN-KEYWORD,pttime

  # HDTime (时光)
  - DOMAIN-SUFFIX,hdtime.org
  - DOMAIN-KEYWORD,hdtime

  # HDArea (好大)
  - DOMAIN-SUFFIX,hdarea.club
  - DOMAIN-KEYWORD,hdarea

  # HDFans (红豆饭)
  - DOMAIN-SUFFIX,hdfans.org
  - DOMAIN-KEYWORD,hdfans

  # HDDolby (杜比)
  - DOMAIN-SUFFIX,hddolby.com
  - DOMAIN-KEYWORD,hddolby

  # AGSVPT (末日)
  - DOMAIN-SUFFIX,agsvpt.com
  - DOMAIN-SUFFIX,agsvpt.cn
  - DOMAIN-SUFFIX,agsvpt.work
  # ⚠ trackers.work 范围较宽，仅建议在确认属于本站 tracker 时保留
  - DOMAIN-SUFFIX,trackers.work
  - DOMAIN-KEYWORD,agsvpt

  # HDVideo (高清视频)
  - DOMAIN-SUFFIX,hdvideo.top
  - DOMAIN-KEYWORD,hdvideo

  # PandaPT (熊猫)
  - DOMAIN-SUFFIX,pandapt.net
  - DOMAIN-KEYWORD,pandapt

  # ZMPT (织梦)
  - DOMAIN-SUFFIX,zmpt.cc
  - DOMAIN-SUFFIX,zmpt.club
  - DOMAIN-KEYWORD,zmpt

  # PTSBao (骚包)
  - DOMAIN-SUFFIX,ptsbao.club
  - DOMAIN-KEYWORD,ptsbao

  # PTHome (铂金家)
  - DOMAIN-SUFFIX,pthome.net
  - DOMAIN-KEYWORD,pthome

  # Qingwa (青蛙)
  - DOMAIN-SUFFIX,qingwa.pro
  - DOMAIN-SUFFIX,qingwa.com
  - DOMAIN-SUFFIX,qingwapt.com
  - DOMAIN-SUFFIX,qingwapt.pro
  - DOMAIN-KEYWORD,qingwa
  - DOMAIN-KEYWORD,qingwapt

  # HDCity (城市)
  - DOMAIN-SUFFIX,hdcity.city

  # PTZone (空间)
  - DOMAIN-SUFFIX,ptzone.xyz
  - DOMAIN-KEYWORD,ptzone

  # BTSchool (学校)
  - DOMAIN-SUFFIX,btschool.club
  - DOMAIN-KEYWORD,btschool

  # HDRoute (思路)
  - DOMAIN-SUFFIX,hdroute.org
  - DOMAIN-KEYWORD,hdroute

  # 52pt (我爱PT)
  - DOMAIN-SUFFIX,52pt.site
  - DOMAIN-KEYWORD,52pt

  # ============================================================================
  # 四、 垂直特色站（动漫 / 音乐 / 汽车 / 港片 / 书籍 / 有声等）
  # ============================================================================
  # U2 (幼儿园)
  - DOMAIN-SUFFIX,u2.dmhy.org
  # ⚠ dmhy 关键字会同时直连 share.dmhy.org 等全站
  - DOMAIN-KEYWORD,dmhy

  # xloli (萝莉)
  - DOMAIN-SUFFIX,xloli.cc
  - DOMAIN-SUFFIX,x-anime.cc

  # DiscFan (碟粉 / 港知堂)
  - DOMAIN-SUFFIX,discfan.net
  - DOMAIN-KEYWORD,discfan

  # DICMusic (海豚 / 音乐大站)
  - DOMAIN-SUFFIX,dicmusic.club
  - DOMAIN-KEYWORD,dicmusic

  # soulvoice (铃音)
  - DOMAIN-SUFFIX,pt.soulvoice.club
  - DOMAIN-KEYWORD,soulvoice

  # Si-Qi (思齐)
  - DOMAIN-SUFFIX,si-qi.xyz

  # CarPT (车站)
  - DOMAIN-SUFFIX,carpt.net
  - DOMAIN-KEYWORD,carpt

  # Piggo (猪猪)
  - DOMAIN-SUFFIX,piggo.me
  - DOMAIN-KEYWORD,piggo

  # ============================================================================
  # 五、 中小型、新晋及特色小站
  # ============================================================================
  # CSPT (财神)
  - DOMAIN-SUFFIX,cspt.top
  - DOMAIN-SUFFIX,cspt.cc
  - DOMAIN-SUFFIX,cspt.date
  - DOMAIN-KEYWORD,cspt

  # CyanBug (大青虫)
  - DOMAIN-SUFFIX,cyanbug.net
  - DOMAIN-KEYWORD,cyanbug

  # HDKylin (麒麟)
  - DOMAIN-SUFFIX,hdkyl.in
  - DOMAIN-SUFFIX,hdkylin.top
  - DOMAIN-KEYWORD,hdkyl

  # UltraHD (韩剧高清站)
  - DOMAIN-SUFFIX,ultrahd.net
  - DOMAIN-KEYWORD,ultrahd

  # ZhuQue (朱雀)
  - DOMAIN-SUFFIX,zhuque.in
  - DOMAIN-KEYWORD,zhuque

  # HaiDan (海胆)
  - DOMAIN-SUFFIX,haidan.cc
  - DOMAIN-KEYWORD,haidan

  # OshenPT (奥神)
  - DOMAIN-SUFFIX,oshen.win
  - DOMAIN-KEYWORD,oshen

  # YeMaPT (野马)
  - DOMAIN-SUFFIX,yemapt.org
  - DOMAIN-KEYWORD,yemapt

  # CrabPT (蟹黄堡)
  - DOMAIN-SUFFIX,crabpt.vip
  - DOMAIN-KEYWORD,crabpt

  # KuFei (库非)
  - DOMAIN-SUFFIX,kufei.org
  - DOMAIN-KEYWORD,kufei

  # PTLGS (PT劳改所)
  - DOMAIN-SUFFIX,ptlgs.org
  - DOMAIN-SUFFIX,ptl.gs

  # XingYunGe (星陨阁)
  - DOMAIN,tracker.xingyungept.org

  # HDBao (红豆包)
  - DOMAIN-SUFFIX,hdbao.cc
  - DOMAIN-KEYWORD,hdbao

  # DStudio
  - DOMAIN-SUFFIX,dstudio.me
  - DOMAIN-KEYWORD,dstudio

  # NovaHD
  - DOMAIN-SUFFIX,novahd.top
  - DOMAIN-KEYWORD,novahd

  # PT.0ff (自由农场)
  # ⚠ 仅精确匹配 pt.0ff.cc；若站有 www / 其他子域，改为 DOMAIN-SUFFIX,0ff.cc
  - DOMAIN,pt.0ff.cc

  # ============================================================================
  # 六、 教育网 / 高校 IPv6 特色站点
  # ============================================================================
  # BYR (北邮人；网页侧需代理，此处只放 tracker)
  - DOMAIN,tracker.byr.pt

  # TJUPT (北洋)
  - DOMAIN-SUFFIX,tjupt.org
  - DOMAIN-KEYWORD,tjupt

  # NanYangPT (南洋)
  - DOMAIN-SUFFIX,nanyangpt.com
  - DOMAIN-KEYWORD,nanyangpt

  # ============================================================================
  # 七、 IP 检测
  # ============================================================================
  # 走直连才会显示家宽出口 IP，用于核对 PT 站看到的 IP
  - DOMAIN-SUFFIX,v6.66666.host
  - DOMAIN-SUFFIX,myip6.ipip.net
  - DOMAIN-SUFFIX,6.ipw.cn
  - DOMAIN-SUFFIX,v6.666666.host
  - DOMAIN-SUFFIX,v4.66666.host
  - DOMAIN-SUFFIX,v4.666666.host
  - DOMAIN-SUFFIX,4.ipw.cn
  - DOMAIN-SUFFIX,ip.3322.net
  - DOMAIN-SUFFIX,myip.ipip.net
  - DOMAIN-SUFFIX,ddns.oray.com

# ==============================================================================
# 附：进程级保险（不能放进 behavior: domain 的规则集，需写在主配置 rules: 段）
# 无论 tracker 用裸 IP、非标准端口还是陌生域名，BT 客户端整体直连最稳妥。
#
#   - PROCESS-NAME,qbittorrent-nox,DIRECT      # Linux / NAS
#   - PROCESS-NAME,qbittorrent,DIRECT          # Windows
#   - PROCESS-NAME,Transmission,DIRECT         # macOS / Windows
#   - PROCESS-NAME,transmission-daemon,DIRECT  # Linux
#   - PROCESS-NAME,deluge,DIRECT
#
# 若客户端跑在 Docker 里，请改用容器 IP 段：
#   - IP-CIDR,172.17.0.0/16,DIRECT,no-resolve
# ==============================================================================
